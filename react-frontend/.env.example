# =============================================================================
# InventoryIQ - Production Environment Configuration Template
# =============================================================================
# IMPORTANT:
# - Do NOT commit active production secret keys to version control.
# - Vite only exposes variables prefixed with VITE_ to the browser client.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend client.
# =============================================================================

# Frontend Public Configuration (Browser Safe)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend Edge Functions Configuration (Server-Side Secrets Only)
# Used inside Supabase CLI or Edge Function secrets:
# supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
